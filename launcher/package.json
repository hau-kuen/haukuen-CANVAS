{
    "name": "canvas-agent-launcher",
    "version": "0.1.6",
    "private": true,
    "description": "Canvas Agent 桌面启动器",
    "author": "tigerowo",
    "main": "electron/main.js",
    "scripts": {
        "start": "electron .",
        "test": "node scripts/verify.js && python scripts/scan-selfcheck.py",
        "verify": "npm test",
        "dist:win": "electron-builder --win --x64",
        "dist:mac": "electron-builder --mac",
        "dist:mac-arm": "electron-builder --mac --arm64",
        "dist:mac-x64": "electron-builder --mac --x64",
        "icon": "python build/make-icon.py"
    },
    "devDependencies": {
        "electron": "^37.2.0",
        "electron-builder": "^25.1.8"
    },
    "build": {
        "appId": "com.tigerowo.canvasagent",
        "productName": "Canvas Agent",
        "copyright": "Copyright © tigerowo",
        "compression": "maximum",
        "asar": true,
        "directories": {
            "output": "dist",
            "buildResources": "build"
        },
        "files": [
            "electron/**/*",
            "ui/**/*",
            "package.json"
        ],
        "extraResources": [
            {
                "from": "../canvas-agent",
                "to": "server",
                "filter": [
                    "**/*",
                    "!data/**",
                    "!**/.git/**",
                    "!**/*.map",
                    "!**/test/**",
                    "!**/__tests__/**",
                    "!**/*.log",
                    "!**/.env",
                    "!**/.env.*",
                    "!**/*.pem",
                    "!**/*.key",
                    "!**/*.p12",
                    "!**/*.db",
                    "!**/*.sqlite*",
                    "!**/*credential*",
                    "!**/*secret*",
                    "!**/codex-agent.json",
                    "!**/launcher.json",
                    "!**/*.ldb",
                    "!**/_*.png",
                    "!**/_*.py"
                ]
            }
        ],
        "win": {
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                }
            ],
            "icon": "build/icon.ico",
            "artifactName": "CanvasAgent-Setup-${version}.${ext}"
        },
        "nsis": {
            "oneClick": false,
            "perMachine": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "shortcutName": "Canvas Agent",
            "include": "build/installer.nsh",
            "deleteAppDataOnUninstall": false
        },
        "mac": {
            "target": [
                {
                    "target": "dmg",
                    "arch": [
                        "arm64",
                        "x64"
                    ]
                }
            ],
            "icon": "build/icon.icns",
            "category": "public.app-category.developer-tools",
            "artifactName": "CanvasAgent-${version}-${arch}.${ext}",
            "darkModeSupport": true,
            "identity": null
        },
        "dmg": {
            "title": "Canvas Agent ${version}",
            "window": {
                "width": 540,
                "height": 380
            },
            "contents": [
                {
                    "x": 140,
                    "y": 190,
                    "type": "file"
                },
                {
                    "x": 400,
                    "y": 190,
                    "type": "link",
                    "path": "/Applications"
                }
            ]
        }
    }
}
